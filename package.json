{
  "name": "webui-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "OpenBMC Web UI using the Vue.js front-end framework",
  "scripts": {
    "serve": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:unit": "npm run test",
    "test:update": "npm test -- -u",
    "test:watch": "vitest --watch",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore  && npm run lint:success || true",
    "lint:success": "echo No lint errors found!",
    "format": "prettier --write src/",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs"
  },
  "dependencies": {
    "@carbon/motion": "11.16.0",
    "@carbon/themes": "11.28.0",
    "@novnc/novnc": "1.4.0",
    "@vitejs/plugin-basic-ssl": "1.2.0",
    "@vuelidate/core": "2.0.3",
    "@vuelidate/validators": "2.0.4",
    "axios": "1.12.2",
    "bootstrap": "5.3.8",
    "bootstrap-vue-next": "0.16.6",
    "buffer": "6.0.3",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.1.3",
    "js-cookie": "3.0.5",
    "json-bigint": "1.0.0",
    "lodash": "4.17.21",
    "n64": "0.2.10",
    "pinia": "2.1.7",
    "qrcode.vue": "3.6.0",
    "tiny-emitter": "2.1.0",
    "totp-generator": "1.0.0",
    "v-calendar": "3.1.2",
    "vue": "3.5.21",
    "vue-axios": "3.5.2",
    "vue-i18n": "9.14.5",
    "vue-router": "4.5.1",
    "vue3-cookies": "1.0.6",
    "xterm": "4.11.0",
    "xterm-addon-attach": "0.6.0",
    "xterm-addon-fit": "0.5.0"
  },
  "devDependencies": {
    "@babel/eslint-parser": "7.28.4",
    "@carbon/icons-vue": "10.28.0",
    "@intlify/unplugin-vue-i18n": "4.0.0",
    "@rollup/plugin-replace": "5.0.7",
    "@rushstack/eslint-patch": "1.12.0",
    "@vitejs/plugin-vue": "4.6.2",
    "@vue/eslint-config-prettier": "8.0.0",
    "@vue/test-utils": "2.4.6",
    "dotenv": "17.0.1",
    "eslint": "8.57.1",
    "eslint-plugin-vitest": "0.5.4",
    "eslint-plugin-vue": "8.7.1",
    "jsdom": "22.1.0",
    "prettier": "3.6.2",
    "sass": "1.69.5",
    "unplugin-vue-components": "0.26.0",
    "vite": "5.4.21",
    "vite-plugin-compression": "0.5.1",
    "vite-plugin-sass": "0.1.0",
    "vitepress": "1.6.3",
    "vitest": "0.33.0",
    "vue-eslint-parser": "10.2.0"
  },
  "lint-staged": {
    "*.{js,vue}": [
      "git add"
    ]
  },
  "parserOptions": {
    "ecmaVersion": 13
  }
}
